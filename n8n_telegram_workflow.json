{
    "name": "Finanzas - Notificaciones Telegram",
    "nodes": [
        {
            "parameters": {
                "rule": {
                    "interval": [
                        {
                            "field": "cronExpression",
                            "expression": "0 8 * * *"
                        }
                    ]
                }
            },
            "id": "78787878-7878-4878-8878-787878787878",
            "name": "Cron Daily 8AM",
            "type": "n8n-nodes-base.scheduleTrigger",
            "typeVersion": 1,
            "position": [
                450,
                300
            ]
        },
        {
            "parameters": {
                "method": "GET",
                "url": "https://odoo-supabase.jyrqup.easypanel.host/rest/v1/reminders",
                "authentication": "headerAuth",
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "apikey",
                            "value": "YOUR_SUPABASE_ANON_KEY"
                        },
                        {
                            "name": "Authorization",
                            "value": "Bearer YOUR_SUPABASE_ANON_KEY"
                        }
                    ]
                },
                "queryParameters": {
                    "parameters": [
                        {
                            "name": "status",
                            "value": "eq.pendiente"
                        },
                        {
                            "name": "select",
                            "value": "*"
                        }
                    ]
                },
                "options": {}
            },
            "id": "12121212-1212-4212-8212-121212121212",
            "name": "Fetch Pendientes",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4,
            "position": [
                650,
                300
            ]
        },
        {
            "parameters": {
                "jsCode": "const reminders = items[0].json;\nconst today = new Date();\ntoday.setHours(0,0,0,0);\n\nconst tomorrow = new Date(today);\ntomorrow.setDate(today.getDate() + 1);\n\nconst dueSoon = reminders.filter(r => {\n  const [y, m, d] = r.date.split('T')[0].split('-').map(Number);\n  const reminderDate = new Date(y, m - 1, d);\n  return reminderDate <= tomorrow;\n});\n\nif (dueSoon.length === 0) return [];\n\nconst message = \"🔔 *Recordatorios de Pago*\\n\\n\" + \n  dueSoon.map(r => `- *${r.description}*: $${r.amount} (Vence: ${r.date.split('T')[0]})`).join('\\n');\n\nreturn [{ json: { message } }];"
            },
            "id": "34343434-3434-4434-8434-343434343434",
            "name": "Filter & Format",
            "type": "n8n-nodes-base.code",
            "typeVersion": 1,
            "position": [
                850,
                300
            ]
        },
        {
            "parameters": {
                "chatId": "YOUR_CHAT_ID",
                "text": "={{ $json.message }}",
                "additionalFields": {
                    "parse_mode": "Markdown"
                }
            },
            "id": "56565656-5656-4656-8656-565656565656",
            "name": "Send Telegram",
            "type": "n8n-nodes-base.telegram",
            "typeVersion": 1,
            "position": [
                1050,
                300
            ],
            "credentials": {
                "telegramApi": {
                    "id": "YOUR_TELEGRAM_BOT_TOKEN_ID",
                    "name": "Telegram Bot"
                }
            }
        }
    ],
    "connections": {
        "Cron Daily 8AM": {
            "main": [
                [
                    {
                        "node": "Fetch Pendientes",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Fetch Pendientes": {
            "main": [
                [
                    {
